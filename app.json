{
  "expo": {
    "name": "shotSight",
    "slug": "shotsight",
    "scheme": "shotsight",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "primaryColor": "#E6B84A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shotsight.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "shotSight connects directly to your target camera on the local range network. Internet access is not required.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.shotsight.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_LOCAL_NETWORK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#101713",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow shotSight to unlock saved camera credentials."
        }
      ],
      [
        "react-native-vlc-media-player",
        {
          "ios": {
            "includeVLCKit": false
          },
          "android": {
            "legacyJetifier": false
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ]
  }
}
